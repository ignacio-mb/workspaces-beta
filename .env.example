# Copy to `.env` and adjust as needed. docker compose reads it automatically.

# Host ports (change if 3000 / 3001 / 5433 are taken on your machine).
METABASE_HOST_PORT=3000
METABASE_DEV_HOST_PORT=3001
WAREHOUSE_HOST_PORT=5433

# By default both instances run a from-source EE build of the
# `workspace-dev-instance-poc` branch (see ./build-branch.sh). Overrides:
#   METABASE_IMAGE    use a registry image instead of building, e.g.
#                     metabase/metabase-enterprise-head:latest (master) or a tag.
#   METABASE_SRC      path to the exported branch source (default below).
#   MB_BUILD_VERSION  version string baked into the build.
# METABASE_IMAGE=metabase/metabase-enterprise-head:latest
# METABASE_SRC=../../master/metabase-src-workspace-dev-instance-poc
# MB_BUILD_VERSION=v1.0.0-workspace-dev-instance-poc

# Enable EE premium features (e.g. transforms). Passed straight through to the
# containers — set it here, never commit a real token. Validated in dev run
# mode against METASTORE_DEV_SERVER_URL below.
# MB_PREMIUM_EMBEDDING_TOKEN=<your-staging-token>
# Token-check server (dev run mode). Must be a full URL with scheme. Defaults to
# the staging store; only set this to override it.
# METASTORE_DEV_SERVER_URL=https://token-check.staging.metabase.com
